# Optional. Without these the app runs fully offline in guest mode.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional. With a key the app uses the real store; without one it stays in
# test mode and no store SDK starts at all.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
