# Client-side Supabase config for the PigeonX web app.
# Copy this file to .env and fill in the values from the repo root .env.
# Both values are public by design: the anon key is safe in a browser bundle,
# row level security is what protects the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Set to 1 to show the Sign in with Apple button. Off by default.
VITE_APPLE_WEB_AUTH=0
